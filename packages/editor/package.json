{
  "name": "@inkdown/editor",
  "version": "0.2.0",
  "description": "TypeScript markdown editor wrapper for Inkdown",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": {
      "import": "@muyajs/core/lib/core.css"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@muyajs/core": "^0.0.39"
  },
  "devDependencies": {
    "typescript": "~5.7.0"
  },
  "peerDependencies": {
    "katex": ">=0.16.0",
    "mermaid": ">=11.0.0",
    "prismjs": ">=1.29.0"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "prismjs": {
      "optional": true
    }
  }
}
